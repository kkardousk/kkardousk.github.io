aes(x = rep_lean_rep, y = date, label = if_else(rn == 1, paste0(rep_lean_rep, "%"), as.character(rep_lean_rep))),
color = color_palette['rep_lean_rep'],
size = 3,
vjust = -1.2
) +
coord_cartesian(xlim = c(-40, 100), clip = "off") +
labs(
x = element_blank(),
y = element_blank(),

# define the watchlist
tickers = ['AAPL', 'GOOGL', 'MSFT', 'TSLA', 'SPY', 'QQQ']
period = "6mo"  # 6 months of data
# looping thru dates
def download_stocks_data(ticker):
try:
stock_data = yf.download(ticker, period=period, progress=False)
logger.info(f'\u2713 Downloaded {ticker}: {len(stock_data)} days')
return (ticker, stock_data)
except Exception as e:
logger.error(f'\u2717 Failed to download {ticker}: {e}')
return (ticker, None)
results = list(map(download_stocks_data, tickers))
results[0]
